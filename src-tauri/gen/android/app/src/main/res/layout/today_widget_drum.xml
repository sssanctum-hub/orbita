<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="94dp"
        android:scaleType="fitXY" android:contentDescription="Сегодня · Орбита · Барабан" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:gravity="center_vertical">
        <AdapterViewFlipper android:id="@+id/widget_drum_top" android:layout_width="match_parent" android:layout_height="44dp"
            android:autoStart="true" android:flipInterval="5000" android:loopViews="true" android:animateFirstView="false"
            android:inAnimation="@animator/widget_drum_in" android:outAnimation="@animator/widget_drum_out" />
        <AdapterViewFlipper android:id="@+id/widget_drum_middle" android:layout_width="match_parent" android:layout_height="44dp"
            android:autoStart="true" android:flipInterval="5000" android:loopViews="true" android:animateFirstView="false"
            android:inAnimation="@animator/widget_drum_in" android:outAnimation="@animator/widget_drum_out" />
        <AdapterViewFlipper android:id="@+id/widget_drum_bottom" android:layout_width="match_parent" android:layout_height="44dp"
            android:autoStart="true" android:flipInterval="5000" android:loopViews="true" android:animateFirstView="false"
            android:inAnimation="@animator/widget_drum_in" android:outAnimation="@animator/widget_drum_out" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:textSize="15sp" android:textColor="#586C77" />
    <ImageView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="42dp"
        android:scaleType="fitXY" android:contentDescription="Орбита" />
</LinearLayout>
